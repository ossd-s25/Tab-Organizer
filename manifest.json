{
    "manifest_version": 3,
    "name": "Tab Organizer",
    "version": "1.0",
    "description": "Organize your tabs by domain and save sessions.",
    "permissions": ["tabs", "storage", "alarms"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    }
  }
  